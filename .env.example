# Docker Compose：复制为项目根目录 .env，勿提交实际配置。
# 使用独立随机密码；此处密码同时写入 PostgreSQL 连接串，推荐仅使用字母和数字。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
# 首次体验使用 demo；真实业务改为 baidu，并配置百度凭据。
SEARCH_MODE=demo
BAIDU_AUTH_MODE=oauth
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 使用 AK/SK 时改为 BAIDU_AUTH_MODE=aksk，填写下面两个字段。
BAIDU_ACCESS_KEY_ID=
BAIDU_ACCESS_KEY_SECRET=
BAIDU_SEARCH_TYPE=materiel
