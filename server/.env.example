# 本地开发：复制为 server/.env；npm 工作区中的后端及 Prisma 使用此文件。
# 以下凭据仅对应 npm run db:local 的开发数据库，部署时必须替换。
# 使用已有 PostgreSQL 时修改连接串；用户名/密码中的特殊字符需要 URL 编码。
DATABASE_URL=postgresql://fabric:fabric_local@127.0.0.1:5432/fabric_sample?schema=public
PORT=3001
HOST=127.0.0.1
STORAGE_DIR=./data/uploads
# demo 无需百度密钥，用于本地体验；真实检索请切换 baidu 并填写下方凭据。
SEARCH_MODE=demo
# oauth 使用应用 API Key / Secret Key；aksk 使用安全认证 AccessKey
BAIDU_AUTH_MODE=oauth
BAIDU_ACCESS_KEY_ID=
BAIDU_ACCESS_KEY_SECRET=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 面料接口为 materiel；切换前须申请对应图库，已有图片须重新入库
BAIDU_SEARCH_TYPE=materiel
CORS_ORIGIN=http://127.0.0.1:5173
# 脚本可选参数：通过运行脚本时的环境变量传入，不自动读取此文件。
# TEST_API_URL=http://127.0.0.1:3001/api
# REINDEX_API_URL=http://127.0.0.1:3001/api
# SCREENSHOT_DIR=/tmp/fabric-sample-ui
